---
interface Props {
  posterOnly?: boolean;
  hidePoster?: boolean;
}

const { posterOnly = false, hidePoster = false } = Astro.props;
const path = Astro.url.pathname;
const currentLang = path.startsWith("/de/") || path === "/de"
  ? "de"
  : path.startsWith("/es/") || path === "/es"
    ? "es"
    : path.startsWith("/en/") || path === "/en"
      ? "en"
      : "nl";

const snnText = {
  nl: {
    title: "Europese samenwerking",
    copy: "Het ontwikkelen van een nieuwe methode voor het meten van leerpret is mede mogelijk gemaakt door financiering van SNN (Samenwerkingsverband Noord Nederland) en de Europese Unie.",
    gallery: "Foto gallerijen",
    logosLabel: "SNN en Europese Unie",
    euAlt: "Europese Unie",
    archiveLabel: "Fotoarchief",
    archiveHref: "/foto-gallerijen/",
    posterTitle: "Aankondiging: Leerpret-engine",
    posterCopy: "Bekijk de EFRO-projectposter over de ontwikkeling van de Leerpret-engine. Deze proof-of-conceptsoftware leidt uit eenvoudige gedragsregistraties af of en in welke mate een leeromgeving leerpret mogelijk maakt, zonder deelnemers tijdens het leren te onderbreken of te bevragen. De werking is intern getoetst met bureau-opstellingen en simulaties.",
    posterLink: "Bekijk de poster (PDF)",
    posterAlt: "EFRO-projectposter over de Leerpret-engine"
  },
  en: {
    title: "European cooperation",
    copy: "The development of a new method for measuring learning enjoyment was made possible in part by funding from SNN (Northern Netherlands Alliance) and the European Union.",
    gallery: "Photo galleries",
    logosLabel: "SNN and the European Union",
    euAlt: "European Union",
    archiveLabel: "Photo archive",
    archiveHref: "/en/photo-galleries/",
    posterTitle: "Announcement: Leerpret Engine",
    posterCopy: "View the EFRO project poster about the development of the Leerpret Engine.",
    posterLink: "View the poster (PDF)",
    posterAlt: "EFRO project poster about the Leerpret Engine"
  },
  de: {
    title: "Europaeische Zusammenarbeit",
    copy: "Die Entwicklung einer neuen Methode zur Messung der Lernfreude wurde durch die Finanzierung von SNN (Northern Netherlands Alliance) und der Europaeischen Union mit ermoeglicht.",
    gallery: "Fotogalerien",
    logosLabel: "SNN und die Europaeische Union",
    euAlt: "Europaeische Union",
    archiveLabel: "Fotoarchiv",
    archiveHref: "/de/fotogalerien/",
    posterTitle: "Ankuendigung: Leerpret-Engine",
    posterCopy: "Sehen Sie das EFRO-Projektposter zur Entwicklung der Leerpret-Engine an.",
    posterLink: "Poster ansehen (PDF)",
    posterAlt: "EFRO-Projektposter zur Leerpret-Engine"
  },
  es: {
    title: "Cooperacion europea",
    copy: "El desarrollo de un nuevo metodo para medir el disfrute del aprendizaje fue posible en parte gracias a la financiacion de SNN (Alianza del Norte de los Paises Bajos) y la Union Europea.",
    gallery: "Galerias de fotos",
    logosLabel: "SNN y la Union Europea",
    euAlt: "Union Europea",
    archiveLabel: "Archivo fotografico",
    archiveHref: "/es/galerias-de-fotos/",
    posterTitle: "Anuncio: motor Leerpret",
    posterCopy: "Consulta el cartel del proyecto EFRO sobre el desarrollo del motor Leerpret.",
    posterLink: "Ver el cartel (PDF)",
    posterAlt: "Cartel del proyecto EFRO sobre el motor Leerpret"
  }
}[currentLang];

const galleryLinks = [
  { label: "Facebook", href: "https://www.facebook.com/lenetworkemmen/" },
  { label: "Flickr", href: "https://www.flickr.com/photos/124144338@N06/" },
  { label: snnText.archiveLabel, href: snnText.archiveHref }
];
---

{posterOnly ? (
  <div class="poster-announcement">
    <a class="poster-preview" href="/assets/announcements/leerpret-engine-efro/leerpret-engine-efro-poster.pdf" target="_blank" rel="noopener">
      <img src="/assets/announcements/leerpret-engine-efro/leerpret-engine-efro-poster.svg" alt={snnText.posterAlt} loading="lazy" />
    </a>
    <div class="poster-copy">
      <p class="snn-eyebrow">EFRO</p>
      <h2>{snnText.posterTitle}</h2>
      <p>{snnText.posterCopy}</p>
      <a class="poster-button" href="/assets/announcements/leerpret-engine-efro/leerpret-engine-efro-poster.pdf" target="_blank" rel="noopener">{snnText.posterLink}</a>
    </div>
  </div>
) : (
<>
<section class="snn-block" aria-labelledby="snn-title">
  <div class="snn-inner">
    <div class="snn-logos" aria-label={snnText.logosLabel}>
      <img src="/assets/uploads/leerpretpark/snn.jpg" alt="SNN" loading="lazy" />
      <img src="/assets/uploads/leerpretpark/europe.png" alt={snnText.euAlt} loading="lazy" />
    </div>
    <div class="snn-copy">
      <p class="snn-eyebrow" id="snn-title">{snnText.title}</p>
      <p>{snnText.copy}</p>
    </div>
  </div>
</section>

{!hidePoster && (
  <div class="poster-announcement poster-announcement--after-europe">
    <a class="poster-preview" href="/assets/announcements/leerpret-engine-efro/leerpret-engine-efro-poster.pdf" target="_blank" rel="noopener">
      <img src="/assets/announcements/leerpret-engine-efro/leerpret-engine-efro-poster.svg" alt={snnText.posterAlt} loading="lazy" />
    </a>
    <div class="poster-copy">
      <p class="snn-eyebrow">EFRO</p>
      <h2>{snnText.posterTitle}</h2>
      <p>{snnText.posterCopy}</p>
      <a class="poster-button" href="/assets/announcements/leerpret-engine-efro/leerpret-engine-efro-poster.pdf" target="_blank" rel="noopener">{snnText.posterLink}</a>
    </div>
  </div>
)}

<section class="gallery-strip" aria-labelledby="gallery-title">
  <div class="gallery-inner">
    <h2 id="gallery-title">{snnText.gallery}</h2>
    <nav aria-label={snnText.gallery}>
      {galleryLinks.map((link) => (
        <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener" : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</section>
</>
)}

<style>
  .snn-block {
    margin-top: 96px;
    background: #f3f0ea;
  }

  .snn-inner {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 46px;
    align-items: center;
    padding: 42px 0 48px;
  }

  .poster-announcement {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(220px, 0.7fr) minmax(0, 1.3fr);
    gap: 52px;
    align-items: center;
    padding: 56px 0 18px;
  }

  .poster-announcement--after-europe {
    padding-top: 56px;
    padding-bottom: 56px;
  }

  .poster-preview {
    display: block;
    overflow: hidden;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.14);
  }

  .poster-preview img {
    display: block;
    width: 100%;
    height: auto;
  }

  .poster-copy h2 {
    margin: 0 0 16px;
    color: #0f172a;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1.04;
  }

  .poster-copy > p:not(.snn-eyebrow) {
    max-width: 640px;
    margin: 0 0 24px;
    color: #566b73;
    font-size: clamp(1.06rem, 1.8vw, 1.25rem);
    line-height: 1.55;
  }

  .poster-button {
    display: inline-flex;
    border-radius: 999px;
    padding: 13px 20px;
    background: #1d81c3;
    color: #fff;
    font-weight: 760;
    text-decoration: none;
  }

  .poster-button:hover,
  .poster-button:focus-visible {
    background: #176da5;
  }

  .snn-logos {
    display: flex;
    align-items: center;
    gap: 34px;
  }

  .snn-logos img {
    display: block;
    width: auto;
    height: 82px;
    object-fit: contain;
    background: #fff;
  }

  .snn-copy {
    color: #566b73;
  }

  .snn-copy p {
    max-width: 860px;
    margin: 0;
    font-size: clamp(1.06rem, 1.8vw, 1.28rem);
    line-height: 1.45;
  }

  .snn-eyebrow {
    margin-bottom: 14px !important;
    color: #9aa4a9;
    font-size: clamp(0.9rem, 1.5vw, 1.1rem) !important;
    font-weight: 780;
    letter-spacing: 0.28em;
    line-height: 1.2 !important;
    text-transform: uppercase;
  }

  .gallery-strip {
    background: #1d81c3;
    color: #fff;
  }

  .gallery-inner {
    width: min(1360px, calc(100% - 56px));
    margin: 0 auto;
    padding: 52px 0 62px;
  }

  .gallery-inner h2 {
    margin: 0 0 28px;
    color: #fff;
    font-size: clamp(1.5rem, 2vw, 2rem);
    font-weight: 780;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .gallery-inner nav {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 28px;
  }

  .gallery-inner a {
    color: #fff;
    font-size: 1.05rem;
    font-weight: 640;
    text-decoration: none;
  }

  .gallery-inner a:hover,
  .gallery-inner a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 760px) {
    .poster-announcement {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-top: 38px;
    }

    .poster-preview {
      width: min(100%, 420px);
      margin: 0 auto;
    }

    .snn-inner {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 34px 0 38px;
    }

    .snn-logos {
      gap: 18px;
    }

    .snn-logos img {
      height: 64px;
    }

    .gallery-inner {
      width: min(100% - 28px, 1360px);
      padding: 42px 0 50px;
    }

    .gallery-inner nav {
      flex-direction: column;
      gap: 14px;
    }
  }
</style>
